APP_NAME=Home
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_LOG_LEVEL=error

APP_URL=http://localhost
APP_PORT=8000
ALLOWED_ORIGINS=*.localhost
REST_API_DOMAIN=api.localhost
ASSET_URL=http://localhost/assets

# Application DB config
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=app_db
DB_USERNAME=root
DB_PASSWORD=secret

# Docker DB config (Build env)
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=app_user
MYSQL_PASSWORD=password
MYSQL_DATABASE=app_db

REDIS_HOST=localhost
REDIS_PASSWORD=secret
REDIS_PORT=6379

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_DRIVER=sync

# Timezone
APP_TIMEZONE=

